{
  "name": "@levanto/ai-sdk-provider",
  "version": "0.1.1",
  "description": "Levanto provider for the Vercel AI SDK: Sage decisions and extraction, and Levanto's LLMs.",
  "license": "MIT",
  "author": "Levanto",
  "homepage": "https://docs.levanto.ai/integrations/vercel-ai-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levantolabs/ai-sdk-provider.git"
  },
  "bugs": {
    "url": "https://github.com/levantolabs/ai-sdk-provider/issues"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel",
    "levanto",
    "sage",
    "decision",
    "extraction",
    "llm"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@ai-sdk/provider": "^4.0.39",
    "@ai-sdk/provider-utils": "^5.0.83"
  },
  "peerDependencies": {
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ai": "^7.0.181",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.1.8"
  }
}
